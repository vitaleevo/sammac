{
  "name": "sammac-site",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:api": "node --env-file=.env.local scripts/verify-api.mjs",
    "format": "prettier --write src convex scripts next.config.ts postcss.config.mjs",
    "test:publication": "tsc src/lib/slug.ts src/lib/validation.ts --outDir output/publication-tests --module commonjs --target es2020 --esModuleInterop --skipLibCheck --strict && node --test scripts/publication.test.mjs"
  },
  "dependencies": {
    "convex": "^1.47.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
